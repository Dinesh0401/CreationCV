# =============================================================================
# ReelMotion AI — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your machine.
# Do NOT commit .env to version control.
# =============================================================================

# --- Server ---
REELMOTION_HOST=127.0.0.1
REELMOTION_PORT=8000
REELMOTION_LOG_LEVEL=INFO
REELMOTION_DEBUG=false

# --- Paths ---
REELMOTION_MODELS_DIR=./models
REELMOTION_CHARACTERS_DIR=./characters
REELMOTION_RECORDINGS_DIR=./recordings
REELMOTION_EXPORTS_DIR=./exports

# --- Hardware overrides (leave empty for auto-detection) ---
REELMOTION_MAX_VRAM_MB=
REELMOTION_MAX_RAM_MB=
REELMOTION_FORCE_CPU=false

# --- Rendering defaults ---
REELMOTION_DEFAULT_WIDTH=1080
REELMOTION_DEFAULT_HEIGHT=1920
REELMOTION_DEFAULT_FPS=30
REELMOTION_DEFAULT_BITRATE=8M

# --- Model downloads ---
REELMOTION_MODEL_CACHE_DIR=./models
REELMOTION_VERIFY_CHECKSUMS=true

